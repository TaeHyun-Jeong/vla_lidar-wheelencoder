<mujoco model="factory_cards">
    <option timestep="0.001" gravity="0 0 -9.81"
            integrator="RK4" solver="PGS" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" />
        
        <rgba fog="0.10 0.12 0.14 1" />
        
        <global azimuth="120" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient"
                 rgb1="0.05 0.08 0.12" rgb2="0.25 0.27 0.30"
                 width="512" height="3072" />

        <material name="floor_mat" rgba="0.6 0.6 0.6 1" reflectance="0" />

        <texture name="maze_logo_tex" type="2d" file="floor.png" />
        <material name="logo_mat" texture="maze_logo_tex" texuniform="false" texrepeat="1 1"/>

        <!-- ====== 여기부터 카드 관련 asset ====== -->

        <!-- 과일 카드 텍스처 & 재질 -->
        <texture name="img_apple_tex"    type="2d" file="cards/apple.png"/>
        <material name="mat_of_apple_mat"   texture="img_apple_tex"/>

        <texture name="img_orange_tex" type="2d" file="cards/orange.png"/>
        <material name="mat_of_orange_mat" texture="img_orange_tex"/>

        <texture name="img_banana_tex"   type="2d" file="cards/banana.png"/>
        <material name="mat_of_banana_mat"  texture="img_banana_tex"/>

        <texture name="img_waterm_tex"   type="2d" file="cards/waterm.png"/>
        <material name="mat_of_waterm_mat"  texture="img_waterm_tex"/>
    </asset>

    <worldbody>
        <light pos="0 0 8" dir="0 0 -1" directional="true" />

        <!-- 바닥을 z = 0 에 둔다 -->
        <geom name="floor_base" type="plane" size="8 6 0.05" pos="0 0 0" material="floor_mat" friction="3 0.5 0.5"/>

        <!-- 로고: 바닥 위에 아주 얇게 깔기 (살짝만 위로) -->
        <geom name="floor_logo"
              type="box"
              pos="0 0 0.001"
              size="7.5 7.5 0.0005"
              material="logo_mat" 
              friction="3 0.5 0.5"/>

        <!-- 벽: 바닥(z=0)에서 위로 2m 정도 올라가도록 (center z=1, half-height=1) -->
        <geom name="wall_maze1"
              type="box"
              pos="-4.1 1.0 1"
              size="0.05 2 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_maze2"
              type="box"
              pos="1.3 2.0 1"
              size="0.05 3 1"
              rgba="0.18 0.20 0.3 1" />

        <body name="wall_ace_apple" pos="1.24 2.0 0.3" euler="0 0 0">
            <geom type="box" size="0.25 0.25 0.001" material="mat_of_apple_mat" rgba="1 1 1 0.6" euler="1.57 1.57 0" contype="0" conaffinity="0"/>
        </body>
        <body name="wall_ace_water" pos="1.24 4 0.3" euler="0 0 0">
            <geom type="box" size="0.25 0.25 0.001" material="mat_of_waterm_mat" rgba="1 1 1 0.6" euler="1.57 1.57 0" contype="0" conaffinity="0"/>
        </body>

        <geom name="wall_maze3"
              type="box"
              pos="-6.5 3 1"
              size="0.05 2 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_maze4"
              type="box"
              pos="-0.7 4.8 1"
              size="2.1 0.05 1"
              rgba="0.18 0.20 0.3 1" />

        <body name="wall_ace_banana" pos="0.7 4.74 0.3" euler="0 0 0">
            <geom type="box" size="0.25 0.25 0.001" material="mat_of_banana_mat" rgba="1 1 1 0.6" euler="1.57 0 0" contype="0" conaffinity="0"/>
        </body>
        <body name="wall_ace_orange" pos="-0.5 4.74 0.3" euler="0 0 0">
            <geom type="box" size="0.25 0.25 0.001" material="mat_of_orange_mat" rgba="1 1 1 0.6" euler="1.57 0 0" contype="0" conaffinity="0"/>
        </body>

        <geom name="wall_maze5"
              type="box"
              pos="-5.5 4.8 1"
              size="1 0.05 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_maze6"
              type="box"
              pos="-2.5 2.7 1"
              size="1.7 0.05 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_maze7"
              type="box"
              pos="-5.3 2.0 1"
              size="1.2 0.05 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_maze8"
              type="box"
              pos="-1.3 -1 1"
              size="2.8 0.05 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_maze9"
              type="box"
              pos="-2.6 1.0 1"
              size="1.5 0.05 1"
              rgba="0.18 0.20 0.3 1" />

        <geom name="wall_front"
              type="box"
              pos="0 6 1"
              size="7 0.1 1"
              rgba="0.18 0.20 0.3 1" />
        
        <geom name="wall_back"
              type="box"
              pos="0 -6 1"
              size="7 0.1 1"
              rgba="0.18 0.20 0.3 1" />
        
        <geom name="wall_left"
              type="box"
              pos="-7 0 1"
              size="0.1 6 1"
              rgba="0.18 0.20 0.3 1" />
        
        <geom name="wall_right"
              type="box"
              pos="7 0 1"
              size="0.1 6 1"
              rgba="0.18 0.20 0.3 1" />

    </worldbody>
    </mujoco>
